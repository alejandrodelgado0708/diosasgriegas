DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres?sslmode=require"
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
SESSION_SECRET="replace-with-a-long-random-secret"
# Configure a private value in your local environment and Vercel; never commit the actual code.
ADMIN_REGISTRATION_CODE=replace-with-a-private-admin-registration-code

# Used to authorize the automatic checkout cron endpoint.
CRON_SECRET=replace-with-a-long-random-secret

# Optional comma-separated WhatsApp recipients (international digits, no + or spaces).
# Defaults to the test and family contact numbers configured in the punch route.
WHATSAPP_PUNCH_PHONES="5491135118731,5491144292660"